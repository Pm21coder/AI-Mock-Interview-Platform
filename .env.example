# .env.example - Example environment variables for local development and Vercel deployment
# Copy this file to .env.local for development and add the real secret values in Vercel Project → Settings → Environment Variables.
# IMPORTANT: Never commit real secrets. Mark server-only secrets in Vercel (do NOT expose to client).

#############################
# Server-only secrets
# (Do NOT expose these to client code)
#############################

# Primary database connection string
# Example: postgres://db_user:db_pass@host:5432/db_name
DATABASE_URL="postgres://user:pass@localhost:5432/ai_mock"

# JWT signing secret used by backend authentication
JWT_SECRET="replace-with-very-long-random-secret"

# Flask secret key (session/csrf)
FLASK_SECRET_KEY="replace-with-flask-secret"
# If your app expects SECRET_KEY instead of FLASK_SECRET_KEY, set that too
SECRET_KEY="replace-with-flask-secret"

# Razorpay - server secret for creating orders and verifying signatures
RAZORPAY_KEY_SECRET="rzp_test_secret_xxx"
# Webhook secret (if using Razorpay webhooks)
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_xxx"

# Caching / rate-limiter storage (Redis recommended)
# Example: redis://:password@redis-host:6379/0
REDIS_URL="redis://localhost:6379/0"
RATELIMIT_STORAGE_URI="redis://localhost:6379/1"

# SMTP / Email configuration
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="sendgrid_api_key_here"
EMAIL_FROM="\"AI Mock\" <noreply@example.com>"

# Error monitoring (optional)
SENTRY_DSN=""

# Third-party OAuth secrets (optional)
THIRD_PARTY_OAUTH_CLIENT_SECRET=""

#############################
# Client-visible (must be prefixed with NEXT_PUBLIC_)
# These values will be embedded in the frontend bundle and are safe only if non-secret
#############################

# Public API base url used by the frontend to call backend APIs
# For Vercel, this should point to your deployed backend endpoint, e.g. https://your-project.vercel.app/api
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000"

# Razorpay public key (used by client-side checkout integration). Keep secret only on server.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxx"

# App display name / analytics ids
NEXT_PUBLIC_APP_NAME="AI Mock Interview"
NEXT_PUBLIC_ANALYTICS_ID=""

#############################
# Feature flags / toggles (optional)
#############################

FEATURE_FLAG_NEW_SUB_FLOW=false

#############################
# Notes for Vercel
#############################
# - In Vercel, add server-only secrets without the NEXT_PUBLIC_ prefix and mark them as "Environment Variable" (do NOT add the NEXT_PUBLIC_ prefix for secrets).
# - Client values that must be available to the browser need the NEXT_PUBLIC_ prefix.
# - After adding or changing env vars, redeploy the project (Vercel will not update running apps until redeploy).
# - Use vercel env add <NAME> <environment> to add vars via Vercel CLI, or vercel env pull .env.local to pull production values locally.

#############################
# Local development
#############################
# Copy to .env.local and fill with local values for running the app locally.
# Example: cp .env.example .env.local
