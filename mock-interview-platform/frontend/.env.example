"# Frontend Environment Variables - TEMPLATE ONLY
# Copy this to .env.local and fill in real values (never commit .env.local to Git)

# Backend API URL (for all API and WebSocket communication)
# This is the main URL for the Flask backend that handles:
# - Authentication (/api/auth/*)
# - Interview generation and feedback (/api/interview/*)
# - Subscription management (/api/subscription/*)
# - WebSocket connections for dashboard updates (/socket.io/*)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Razorpay Payment Gateway
# Use TEST key (rzp_test_*) for development
# Use LIVE key (rzp_live_*) ONLY for production after full testing
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID

# Debug Mode (set to 'true' to enable debug logging)
NEXT_PUBLIC_DEBUG=false" 
