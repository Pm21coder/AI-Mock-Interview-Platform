# Backend environment variables template
# Copy to backend/.env and fill in real values for local development.

# Flask / App
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-secret-key-change-in-production
FLASK_DEBUG=True

# MongoDB (local development default)
# MONGODB_URI=mongodb://localhost:27017/mock_interview?authSource=admin

# Gemini (Google) - optional
# GOOGLE_GEMINI_API_KEY=
# GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
# ENABLE_GEMINI=true

# OpenAI (optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-3.5-turbo

# Generic HTTP LLM provider (e.g., Deepseek)
# Set both LLM_API_KEY and LLM_API_URL to enable the HTTP provider used by ai_pipeline
# LLM_API_KEY=
# LLM_API_URL=https://api.example-llm.com/v1/generate
# LLM_PROVIDER=deepseek

# Razorpay (payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Other settings
# USE_ATLAS_MONGO=false
# REQUIRE_REDIS_IN_PRODUCTION=true
