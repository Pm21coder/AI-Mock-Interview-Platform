"# Backend Environment Variables - TEMPLATE ONLY
# Copy this to .env and fill in real values (never commit .env to Git)

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mock_interview?retryWrites=true&w=majority

# Google Gemini AI Configuration
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GEMINI_MODEL=gemini-3.6-flash
ENABLE_GEMINI=true
GEMINI_TIMEOUT_SECONDS=30

# Security Keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-random-jwt-secret-here
SECRET_KEY=your-random-secret-key-here

# Razorpay Payment Gateway
# Use TEST keys (rzp_test_*) for development
# Use LIVE keys (rzp_live_*) ONLY for production after full testing
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=rzp_test_YOUR_TEST_SECRET

# Email Configuration for Contact Form
# Follow instructions in EMAIL_SETUP.md to generate an app password
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Debug Mode (set to False in production)
FLASK_DEBUG=False

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000" 
