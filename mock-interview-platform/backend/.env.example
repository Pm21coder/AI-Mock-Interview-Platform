# MongoDB Atlas Connection (Get from https://cloud.mongodb.com/)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mock_interview?retryWrites=true&w=majority

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GEMINI_MODEL=gemini-2.0-flash
ENABLE_GEMINI=true
GEMINI_TIMEOUT_SECONDS=10

# Flask Configuration
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-change-in-production

# JWT Configuration (use a strong random string)
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Razorpay Configuration
# Get test keys from: https://dashboard.razorpay.com/settings/api-keys
# IMPORTANT: Use test keys (rzp_test_*) for development, never commit live keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key
RAZORPAY_CURRENCY=INR

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000

# MongoDB Connection Timeouts (in milliseconds)
MONGO_CONNECT_TIMEOUT_MS=1500
